<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

    <description>Product Management Component Site Configuration File</description>

    <!-- Request Mappings -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindProduct"/>
    </request-map>
    
    <request-map uri="FindProduct">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindProduct"/>
    </request-map>

    <request-map uri="createProduct">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://ProductManagement/src/main/groovy/org/apache/ofbiz/productmanagement/ProductEvents.groovy" invoke="createProductEvent"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error" type="view" value="FindProduct"/>
    </request-map>

    <request-map uri="updateProduct">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://ProductManagement/src/main/groovy/org/apache/ofbiz/productmanagement/ProductEvents.groovy" invoke="updateProductEvent"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error" type="view" value="FindProduct"/>
    </request-map>

    <request-map uri="assocProductToVirtual">
        <security https="true" auth="true"/>
        <event type="service" invoke="assocProductToVirtual"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error" type="view" value="FindProduct"/>
    </request-map>

    <request-map uri="updateProductVariant">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateProductVariant"/>
        <response name="success" type="view" value="FindProduct"/>
        <response name="error" type="view" value="FindProduct"/>
    </request-map>

    <!-- View Mappings -->
    <view-map name="FindProduct" type="screen" page="component://ProductManagement/widget/ProductManagementScreens.xml#FindProduct"/>
</site-conf>
