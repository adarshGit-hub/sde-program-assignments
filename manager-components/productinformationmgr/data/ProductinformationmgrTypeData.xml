<entity-engine-xml>
    <!-- ========================================== -->
    <!-- 2. Product Types (Type-Subtype Pattern)   -->
    <!-- ========================================== -->
    <!-- Custom ProductType that is a subtype of standard FINISHED_GOOD -->
    <ProductType productTypeId="ELECTRONIC_GOOD" parentTypeId="FINISHED_GOOD" hasTable="N" description="Electronic Good"/>
    <ProductType productTypeId="SOFTWARE_LICENSE" parentTypeId="DIGITAL_GOOD" hasTable="N" description="Software License"/>

    <!-- ========================================== -->
    <!-- 3. Category Types (Type-Subtype Pattern)  -->
    <!-- ========================================== -->
    <!-- Custom ProductCategoryType that is a subtype of standard CATALOG_CATEGORY -->
    <ProductCategoryType productCategoryTypeId="TECH_CATEGORY" parentTypeId="CATALOG_CATEGORY" hasTable="N" description="Technology Category"/>

    <!-- ========================================== -->
    <!-- 5. Feature Types (Type-Subtype Pattern)   -->
    <!-- ========================================== -->
    <!-- Custom Feature Types that inherit from general types to show subtyping -->
    <ProductFeatureType productFeatureTypeId="TECH_SPEC" parentTypeId="" hasTable="N" description="Technical Specification"/>
    <ProductFeatureType productFeatureTypeId="TECH_MEM" parentTypeId="TECH_SPEC" hasTable="N" description="Memory Capacity"/>
    <ProductFeatureType productFeatureTypeId="TECH_CLR" parentTypeId="" hasTable="N" description="Color Specification"/>
</entity-engine-xml>