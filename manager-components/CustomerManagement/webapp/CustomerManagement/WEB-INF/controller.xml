<?xml version="1.0" encoding="UTF-8"?>
<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/site-conf.xsd">

    <description>Customer Management Controller Configuration</description>

    <handler name="java" type="request" class="org.apache.ofbiz.webapp.event.JavaEventHandler"/>
    <handler name="groovy" type="request" class="org.apache.ofbiz.webapp.event.GroovyEventHandler"/>
    <handler name="screen" type="view" class="org.apache.ofbiz.widget.renderer.macro.MacroScreenViewHandler"/>

    <!-- Request Mappings -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="request" value="FindCustomer"/>
    </request-map>

    <request-map uri="FindCustomer">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindCustomer"/>
    </request-map>

    <request-map uri="createCustomer">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://CustomerManagement/src/main/groovy/org/apache/ofbiz/customermanagement/CustomerEvents.groovy" invoke="createCustomerEvent"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error" type="view" value="FindCustomer"/>
    </request-map>

    <request-map uri="updateCustomer">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://CustomerManagement/src/main/groovy/org/apache/ofbiz/customermanagement/CustomerEvents.groovy" invoke="updateCustomerEvent"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error" type="view" value="FindCustomer"/>
    </request-map>

    <request-map uri="createCustomerRelationship">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://CustomerManagement/src/main/groovy/org/apache/ofbiz/customermanagement/CustomerEvents.groovy" invoke="createCustomerRelationshipEvent"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error" type="view" value="FindCustomer"/>
    </request-map>

    <request-map uri="updateCustomerRelationship">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://CustomerManagement/src/main/groovy/org/apache/ofbiz/customermanagement/CustomerEvents.groovy" invoke="updateCustomerRelationshipEvent"/>
        <response name="success" type="view" value="FindCustomer"/>
        <response name="error" type="view" value="FindCustomer"/>
    </request-map>

    <!-- View Mappings -->
    <view-map name="FindCustomer" type="screen" page="component://CustomerManagement/widget/CustomerManagementScreens.xml#FindCustomer"/>

</site-conf>
